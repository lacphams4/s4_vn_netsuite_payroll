      <fieldtype>FLOAT</fieldtype>
      <description>Amount (G, S) or attainment percent (A, B) where the tier starts; the tier applies from this value inclusive.</description>
      <help>Amount (G, S) or attainment percent (A, B) where the tier starts; the tier applies from this value inclusive.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
