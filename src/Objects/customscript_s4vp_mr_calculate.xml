  <scriptfile>[/SuiteScripts/com.s4.vnpayroll/scripts/s4vp_mr_calculate.js]</scriptfile>
  <description>Calculates large payroll batches in chunks of 50 employee lines, then totals the batch.</description>
  <isinactive>F</isinactive>
  <notifyadmins>F</notifyadmins>
  <notifyowner>T</notifyowner>
  <scriptcustomfields>
    <scriptcustomfield scriptid="custscript_s4vp_mr_batch">
      <label>Payroll batch internal ID</label>
      <fieldtype>TEXT</fieldtype>
      <description>Internal ID of the payroll batch to calculate (set by the payroll screen).</description>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
    </scriptcustomfield>
  </scriptcustomfields>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_s4vp_mr_calculate">
      <isdeployed>T</isdeployed>
      <loglevel>AUDIT</loglevel>
      <status>NOTSCHEDULED</status>
      <title>S4VP Payroll Calculation</title>
    </scriptdeployment>
  </scriptdeployments>
</mapreducescript>
