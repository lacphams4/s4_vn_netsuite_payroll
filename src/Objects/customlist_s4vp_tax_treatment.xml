    <customvalue scriptid="val_s4vp_tax_treatment_e">
      <value>E - Miễn thuế</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_tax_treatment_c">
      <value>C - Miễn đến trần</value>
      <isinactive>F</isinactive>
