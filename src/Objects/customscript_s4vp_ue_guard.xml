    </scriptdeployment>
    <scriptdeployment scriptid="customdeploy_s4vp_ue_guard_batch_time">
      <isdeployed>T</isdeployed>
      <loglevel>AUDIT</loglevel>
      <recordtype>[customrecord_s4vp_batch_time]</recordtype>
      <status>RELEASED</status>
      <allroles>T</allroles>
    </scriptdeployment>
  </scriptdeployments>
</usereventscript>
