<customrecordtype scriptid="customrecord_s4vp_check_result">
  <recordname>S4VP Kết quả xử lý cảnh báo bảng lương</recordname>
  <description>Handling result of a payroll check (UI v2): one row per batch, rule and employee. The checks themselves are recomputed on read and are not stored. Acumatica screen UI2. Generated by tools/gen_objects.mjs.</description>
  <accesstype>USEPERMISSIONLIST</accesstype>
  <allowattachments>T</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlineediting>F</allowinlineediting>
  <allowquicksearch>F</allowquicksearch>
  <allowuiaccess>T</allowuiaccess>
  <enablekeywords>F</enablekeywords>
  <enablenumbering>F</enablenumbering>
  <enableoptimisticlocking>T</enableoptimisticlocking>
  <enablesystemnotes>T</enablesystemnotes>
  <hierarchical>F</hierarchical>
  <includename>F</includename>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <showcreationdate>T</showcreationdate>
  <showlastmodified>T</showlastmodified>
  <showowner>F</showowner>
  <shownotes>T</shownotes>
  <customrecordcustomfields>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_batch">
      <label>Bảng lương</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>[customrecord_s4vp_batch]</selectrecordtype>
      <description>Bảng lương</description>
      <help>Bảng lương</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_rule">
      <label>Quy tắc</label>
      <fieldtype>TEXT</fieldtype>
      <description>Rule code of core/PayrollChecks, for example NET_CHANGE.</description>
      <help>Rule code of core/PayrollChecks, for example NET_CHANGE.</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_employee">
      <label>Nhân viên</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-4</selectrecordtype>
      <description>Empty for batch-level checks.</description>
      <help>Empty for batch-level checks.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_status">
      <label>Trạng thái</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>[customlist_s4vp_bck_status]</selectrecordtype>
      <description>Trạng thái</description>
      <help>Trạng thái</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_assignee">
      <label>Người phụ trách</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-4</selectrecordtype>
      <description>Người phụ trách</description>
      <help>Người phụ trách</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_note">
      <label>Ghi chú</label>
      <fieldtype>TEXTAREA</fieldtype>
      <description>Ghi chú</description>
      <help>Ghi chú</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_updated_by">
      <label>Người cập nhật</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-4</selectrecordtype>
      <description>Người cập nhật</description>
      <help>Người cập nhật</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_updated_date">
      <label>Ngày cập nhật</label>
      <fieldtype>DATE</fieldtype>
      <description>Ngày cập nhật</description>
      <help>Ngày cập nhật</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_key">
      <label>Khóa (quy tắc:nhân viên)</label>
      <fieldtype>TEXT</fieldtype>
      <description>Khóa (quy tắc:nhân viên)</description>
      <help>Khóa (quy tắc:nhân viên)</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>HIDDEN</displaytype>
      <isparent>F</isparent>
      <showinlist>F</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_stamp">
      <label>Dấu số liệu khi đóng</label>
      <fieldtype>TEXT</fieldtype>
      <description>Short hash of the figures behind the check when it was closed; the check reopens when the figures change. No amounts are stored.</description>
      <help>Short hash of the figures behind the check when it was closed; the check reopens when the figures change. No amounts are stored.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>HIDDEN</displaytype>
      <isparent>F</isparent>
      <showinlist>F</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_bck_history">
      <label>Lịch sử xử lý (JSON)</label>
      <fieldtype>CLOBTEXT</fieldtype>
      <description>Lịch sử xử lý (JSON)</description>
      <help>Lịch sử xử lý (JSON)</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>HIDDEN</displaytype>
      <isparent>F</isparent>
      <showinlist>F</showinlist>
    </customrecordcustomfield>
  </customrecordcustomfields>
  <permissions>
    <permission>
      <permittedlevel>EDIT</permittedlevel>
      <permittedrole>[customrole_s4vp_hr]</permittedrole>
    </permission>
    <permission>
      <permittedlevel>EDIT</permittedlevel>
      <permittedrole>[customrole_s4vp_accountant]</permittedrole>
    </permission>
    <permission>
      <permittedlevel>VIEW</permittedlevel>
      <permittedrole>[customrole_s4vp_selfservice]</permittedrole>
    </permission>
    <permission>
      <permittedlevel>FULL</permittedlevel>
      <permittedrole>[customrole_s4vp_demo]</permittedrole>
    </permission>
  </permissions>
</customrecordtype>
