    <customvalue scriptid="val_s4vp_symbol_category_s">
      <value>S - BHXH trả</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_symbol_category_t">
      <value>T - Công tác</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_symbol_category_n">
      <value>N - Không tính</value>
