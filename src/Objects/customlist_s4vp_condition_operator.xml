<customlist scriptid="customlist_s4vp_condition_operator">
  <name>S4VP condition_operator</name>
  <description>S4 VN Payroll code list condition_operator; values keep the Acumatica codes (G, L, E).</description>
  <isinactive>F</isinactive>
  <isordered>T</isordered>
  <customvalues>
    <customvalue scriptid="val_s4vp_condition_operator_g">
      <value>&gt;=</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_condition_operator_l">
      <value>&lt;=</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_condition_operator_e">
      <value>=</value>
      <isinactive>F</isinactive>
    </customvalue>
  </customvalues>
</customlist>
