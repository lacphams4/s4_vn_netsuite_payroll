<customrecordtype scriptid="customrecord_s4vp_approval_log">
  <recordname>S4VP Nhật ký duyệt bảng lương</recordname>
  <description>Payroll approval log (UI v2): one row per decision of a level in a submission round. Append only; holds no pay amounts. Acumatica screen UI2. Generated by tools/gen_objects.mjs.</description>
  <accesstype>USEPERMISSIONLIST</accesstype>
  <allowattachments>T</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlineediting>F</allowinlineediting>
  <allowquicksearch>F</allowquicksearch>
  <allowuiaccess>T</allowuiaccess>
  <enablekeywords>F</enablekeywords>
  <enablenumbering>F</enablenumbering>
  <enableoptimisticlocking>T</enableoptimisticlocking>
  <enablesystemnotes>T</enablesystemnotes>
  <hierarchical>F</hierarchical>
  <includename>F</includename>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <showcreationdate>T</showcreationdate>
  <showlastmodified>T</showlastmodified>
  <showowner>F</showowner>
  <shownotes>T</shownotes>
  <customrecordcustomfields>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_batch">
      <label>Bảng lương</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>[customrecord_s4vp_batch]</selectrecordtype>
      <description>Bảng lương</description>
      <help>Bảng lương</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_round">
      <label>Lượt gửi duyệt</label>
      <fieldtype>INTEGER</fieldtype>
      <description>Submission round of the batch, starting at 1. A rejection or reopening ends the round.</description>
      <help>Submission round of the batch, starting at 1. A rejection or reopening ends the round.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_level">
      <label>Cấp</label>
      <fieldtype>INTEGER</fieldtype>
      <description>Cấp</description>
      <help>Cấp</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_step_name">
      <label>Tên cấp</label>
      <fieldtype>TEXT</fieldtype>
      <description>Tên cấp</description>
      <help>Tên cấp</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_approver">
      <label>Người quyết định</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-4</selectrecordtype>
      <description>Người quyết định</description>
      <help>Người quyết định</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_approver_name">
      <label>Tên người quyết định</label>
      <fieldtype>TEXT</fieldtype>
      <description>Tên người quyết định</description>
      <help>Tên người quyết định</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_decision">
      <label>Quyết định</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>[customlist_s4vp_apv_decision]</selectrecordtype>
      <description>Quyết định</description>
      <help>Quyết định</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_at">
      <label>Thời điểm (UTC, ISO)</label>
      <fieldtype>TEXT</fieldtype>
      <description>UTC timestamp in ISO 8601.</description>
      <help>UTC timestamp in ISO 8601.</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_date">
