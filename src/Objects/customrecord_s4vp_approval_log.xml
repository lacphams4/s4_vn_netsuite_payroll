      <fieldtype>DATE</fieldtype>
      <description>Ngày</description>
      <help>Ngày</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_note">
      <label>Ghi chú</label>
      <fieldtype>TEXTAREA</fieldtype>
      <description>Ghi chú</description>
      <help>Ghi chú</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_apl_waived">
      <label>Miễn tách nhiệm vụ</label>
      <fieldtype>CHECKBOX</fieldtype>
      <description>Checked when the same person approved two consecutive levels because nobody else could approve this level.</description>
      <help>Checked when the same person approved two consecutive levels because nobody else could approve this level.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>LOCKED</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
      <defaultchecked>F</defaultchecked>
    </customrecordcustomfield>
  </customrecordcustomfields>
  <permissions>
    <permission>
      <permittedlevel>CREATE</permittedlevel>
      <permittedrole>[customrole_s4vp_hr]</permittedrole>
    </permission>
    <permission>
      <permittedlevel>CREATE</permittedlevel>
      <permittedrole>[customrole_s4vp_accountant]</permittedrole>
    </permission>
  </permissions>
</customrecordtype>
