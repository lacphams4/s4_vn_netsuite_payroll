<customlist scriptid="customlist_s4vp_hrc_type">
  <name>S4VP hrc_type</name>
  <description>S4 VN Payroll code list hrc_type; values keep the Acumatica codes (P, F, U, S, C).</description>
  <isinactive>F</isinactive>
  <isordered>T</isordered>
  <customvalues>
    <customvalue scriptid="val_s4vp_hrc_type_p">
      <value>P - Thử việc</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_hrc_type_f">
      <value>F - Xác định thời hạn</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_hrc_type_u">
      <value>U - Không xác định thời hạn</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_hrc_type_s">
      <value>S - Thời vụ / khoán việc</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_hrc_type_c">
      <value>C - Cộng tác viên / dịch vụ</value>
      <isinactive>F</isinactive>
    </customvalue>
  </customvalues>
</customlist>
