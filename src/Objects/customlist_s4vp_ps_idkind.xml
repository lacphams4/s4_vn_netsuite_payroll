  <description>S4 VN Payroll code list ps_idkind; values keep the Acumatica codes (N, M, B).</description>
  <isinactive>F</isinactive>
  <isordered>T</isordered>
  <customvalues>
    <customvalue scriptid="val_s4vp_ps_idkind_n">
      <value>N - Mã nhân viên NetSuite</value>
      <isinactive>F</isinactive>
