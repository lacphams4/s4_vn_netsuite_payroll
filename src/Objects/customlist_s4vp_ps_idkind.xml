    <customvalue scriptid="val_s4vp_ps_idkind_m">
      <value>M - Theo bảng đối chiếu</value>
      <isinactive>F</isinactive>
    </customvalue>
    <customvalue scriptid="val_s4vp_ps_idkind_b">
      <value>B - Bảng đối chiếu, rồi mã nhân viên</value>
      <isinactive>F</isinactive>
    </customvalue>
  </customvalues>
</customlist>
