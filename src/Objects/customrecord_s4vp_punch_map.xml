<customrecordtype scriptid="customrecord_s4vp_punch_map">
  <recordname>S4VP Đối chiếu mã chấm công</recordname>
  <description>Attendance device ID mapping: source + device + device ID + effective date -&gt; employee. Rows for the same device win over rows with no device. Acumatica screen UI2. Generated by tools/gen_objects.mjs.</description>
  <accesstype>USEPERMISSIONLIST</accesstype>
  <allowattachments>T</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlineediting>F</allowinlineediting>
  <allowquicksearch>F</allowquicksearch>
  <allowuiaccess>T</allowuiaccess>
  <enablekeywords>F</enablekeywords>
  <enablenumbering>F</enablenumbering>
  <enableoptimisticlocking>T</enableoptimisticlocking>
  <enablesystemnotes>T</enablesystemnotes>
  <hierarchical>F</hierarchical>
  <includename>F</includename>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <showcreationdate>T</showcreationdate>
  <showlastmodified>T</showlastmodified>
  <showowner>F</showowner>
  <shownotes>T</shownotes>
  <customrecordcustomfields>
    <customrecordcustomfield scriptid="custrecord_s4vp_pmp_source">
      <label>Hồ sơ nguồn</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>[customrecord_s4vp_punch_source]</selectrecordtype>
      <description>Hồ sơ nguồn</description>
      <help>Hồ sơ nguồn</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_pmp_device">
      <label>Thiết bị</label>
      <fieldtype>TEXT</fieldtype>
      <description>Empty = every device of the source.</description>
      <help>Empty = every device of the source.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_pmp_machine_id">
      <label>Mã trên máy chấm công</label>
      <fieldtype>TEXT</fieldtype>
      <description>Mã trên máy chấm công</description>
      <help>Mã trên máy chấm công</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_pmp_employee">
      <label>Nhân viên</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>-4</selectrecordtype>
      <description>Nhân viên</description>
      <help>Nhân viên</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_pmp_effective">
      <label>Hiệu lực từ</label>
      <fieldtype>DATE</fieldtype>
      <description>Empty = from the beginning.</description>
      <help>Empty = from the beginning.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_pmp_expiration">
      <label>Hiệu lực đến</label>
      <fieldtype>DATE</fieldtype>
      <description>Empty = no end.</description>
      <help>Empty = no end.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
  </customrecordcustomfields>
  <permissions>
    <permission>
      <permittedlevel>EDIT</permittedlevel>
      <permittedrole>[customrole_s4vp_hr]</permittedrole>
    </permission>
    <permission>
      <permittedlevel>VIEW</permittedlevel>
      <permittedrole>[customrole_s4vp_accountant]</permittedrole>
    </permission>
    <permission>
      <permittedlevel>VIEW</permittedlevel>
      <permittedrole>[customrole_s4vp_selfservice]</permittedrole>
    </permission>
  </permissions>
</customrecordtype>
