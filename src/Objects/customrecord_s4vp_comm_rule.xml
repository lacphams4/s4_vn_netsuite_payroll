      <help>Comma separated location internal ids. Empty = no filter.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_ccr_f_cust_categories">
