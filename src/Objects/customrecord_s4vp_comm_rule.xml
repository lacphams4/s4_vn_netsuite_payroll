      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>[customrecord_s4vp_comm_plan]</selectrecordtype>
      <description>Kế hoạch</description>
      <help>Kế hoạch</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_ccr_sequence">
      <label>Thứ tự</label>
      <fieldtype>INTEGER</fieldtype>
      <description>Thứ tự</description>
      <help>Thứ tự</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_ccr_f_items">
      <label>Lọc mặt hàng (id)</label>
      <fieldtype>TEXT</fieldtype>
      <description>Comma separated item internal ids. Empty = no filter.</description>
      <help>Comma separated item internal ids. Empty = no filter.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
