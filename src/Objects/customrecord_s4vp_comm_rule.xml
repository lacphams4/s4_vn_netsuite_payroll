      <fieldtype>TEXT</fieldtype>
      <description>Comma separated class internal ids. Empty = no filter.</description>
      <help>Comma separated class internal ids. Empty = no filter.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_ccr_f_departments">
      <label>Lọc phòng ban (id)</label>
      <fieldtype>TEXT</fieldtype>
      <description>Comma separated department internal ids. Empty = no filter.</description>
      <help>Comma separated department internal ids. Empty = no filter.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
