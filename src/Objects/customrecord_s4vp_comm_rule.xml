      <fieldtype>INTEGER</fieldtype>
      <description>Default 90.</description>
      <help>Default 90.</help>
      <ismandatory>F</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_s4vp_ccr_method">
      <label>Phương pháp</label>
      <fieldtype>SELECT</fieldtype>
      <selectrecordtype>[customlist_s4vp_cm_method]</selectrecordtype>
      <description>P flat rate, G graduated tiers by value, S step tiers by value, A rate by attainment tier, U amount per unit, B milestone bonus by attainment.</description>
      <help>P flat rate, G graduated tiers by value, S step tiers by value, A rate by attainment tier, U amount per unit, B milestone bonus by attainment.</help>
      <ismandatory>T</ismandatory>
      <storevalue>T</storevalue>
      <displaytype>NORMAL</displaytype>
      <isparent>F</isparent>
      <showinlist>T</showinlist>
