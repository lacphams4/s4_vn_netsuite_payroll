<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<!-- VP646000 Bảng hoa hồng theo nhân viên của một bảng lương, A4 dọc. Dữ liệu: alias data, dựng bằng core/PrintModelExtra.commission. -->
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<macrolist>
		<macro id="pagefooter">
			<table width="100%"><tr><td align="right" style="font-size: 7pt; color: #666666;"><pagenumber/> / <totalpages/></td></tr></table>
		</macro>
	</macrolist>
	<style type="text/css">
		body { font-family: NotoSans, sans-serif; font-size: 8.5pt; }
		td { padding: 2px 3px; vertical-align: top; }
		table.grid { border-collapse: collapse; }
		table.grid th { border: 0.5pt solid #000000; font-weight: bold; vertical-align: middle; padding: 3px; font-size: 7.5pt; }
		p.h { margin: 0; text-align: center; }
		table.grid td { border: 0.5pt solid #000000; font-size: 8pt; }
		.b { font-weight: bold; }
		.i { font-style: italic; }
		.title { font-size: 13pt; font-weight: bold; }
		.small { font-size: 7pt; }
	</style>
</head>
<body size="A4" padding="1.2cm 1.2cm 1.0cm 1.4cm" footer="pagefooter" footer-height="0.6cm">
	<table width="100%"><tr>
		<#list data.logos as l><td width="10%" style="vertical-align: middle;"><img src="${l.url?html}" style="height: 28px;" /></td></#list>
		<td style="vertical-align: middle;"><span class="b">${data.companyName?html}</span><#list data.companyLines as c><br/>${c?html}</#list></td>
	</tr></table>
	<p class="title" align="center">${data.title?html}</p>
	<p align="center">${data.periodLine?html}</p>
	<p align="right" class="small i">${data.note?html} ${data.currencyLine?html}</p>
	<table class="grid" width="100%" table-layout="fixed">
		<thead><tr>
			<th width="5%" align="center"><p class="h" align="center">${data.heads.stt?html}</p></th>
			<th width="9%" align="center"><p class="h" align="center">${data.heads.code?html}</p></th>
			<th width="22%" align="center"><p class="h" align="center">${data.heads.name?html}</p></th>
			<th width="10%" align="center"><p class="h" align="center">${data.heads.rule?html}</p></th>
			<th width="14%" align="center"><p class="h" align="center">${data.heads.sales?html}</p></th>
			<th width="13%" align="center"><p class="h" align="center">${data.heads.target?html}</p></th>
			<th width="7%" align="center"><p class="h" align="center">${data.heads.achieved?html}</p></th>
			<th width="7%" align="center"><p class="h" align="center">${data.heads.rate?html}</p></th>
			<th width="13%" align="center"><p class="h" align="center">${data.heads.amount?html}</p></th>
		</tr></thead>
		<#list data.rows as r>
		<tr>
			<td align="center">${r.stt}</td><td>${r.code?html}</td><td>${r.name?html}</td><td>${r.rule?html}</td>
			<td align="right">${r.sales}</td><td align="right">${r.target}</td><td align="right">${r.achieved}</td><td align="right">${r.rate}</td>
			<td align="right" class="b">${r.amount}</td>
		</tr>
		</#list>
		<tr>
			<td colspan="4" class="b" align="center">${data.heads.total?html}</td>
			<td align="right" class="b">${data.total.sales}</td><td colspan="3"></td><td align="right" class="b">${data.total.amount}</td>
		</tr>
	</table>
	<p class="i" style="margin-top: 4px;">${data.words?html}</p>
	<table width="100%" table-layout="fixed" style="margin-top: 10px; page-break-inside: avoid;">
		<tr><#list data.signers as s><td width="33%" align="center"><span class="b">${s.title?html}</span><br/><span class="small i">${data.signNote?html}</span><br/><br/><br/><br/>${s.name?html}</td></#list></tr>
	</table>
</body>
</pdf>
