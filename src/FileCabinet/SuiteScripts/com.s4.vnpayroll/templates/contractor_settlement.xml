<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<!-- VP644000 Bảng quyết toán chi phí cộng tác viên, A4 ngang. Dữ liệu: alias data, dựng bằng core/PrintModel.contractorSettlement. -->
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<macrolist>
		<macro id="pagefooter">
			<table width="100%"><tr><td align="right" style="font-size: 7pt; color: #666666;"><pagenumber/> / <totalpages/></td></tr></table>
		</macro>
	</macrolist>
	<style type="text/css">
		body { font-family: NotoSans, sans-serif; font-size: 8.5pt; }
		td { padding: 2px 3px; vertical-align: top; }
		table.grid { border-collapse: collapse; }
		table.grid th { border: 0.5pt solid #000000; font-weight: bold; vertical-align: middle; padding: 3px; }
		p.h { margin: 0; text-align: center; }
		table.grid td { border: 0.5pt solid #000000; }
		.b { font-weight: bold; }
		.i { font-style: italic; }
		.title { font-size: 12pt; font-weight: bold; }
		.small { font-size: 7pt; }
	</style>
</head>
<body size="A4-landscape" padding="1.0cm 1.2cm 1.0cm 1.4cm" footer="pagefooter" footer-height="0.6cm">
	<table width="100%"><tr>
		<#list data.logos as l><td width="8%" style="vertical-align: middle;"><img src="${l.url?html}" style="height: 28px;" /></td></#list>
		<td style="vertical-align: middle;"><span class="b">${data.companyName?html}</span><#list data.companyLines as c><br/>${c?html}</#list></td>
	</tr></table>
	<p class="title" align="center">${data.title?html}</p>
	<p align="center">${data.periodLine?html} - ${data.batchLine?html}</p>
	<p align="center" class="small">${data.windowLine?html}</p>
	<p align="right" class="small i">${data.currencyLine?html}</p>
	<table class="grid" width="100%" table-layout="fixed">
		<thead><tr>
			<th width="4%" align="center"><p class="h" align="center">${data.heads.stt?html}</p></th>
			<th width="18%" align="center"><p class="h" align="center">${data.heads.name?html}</p></th>
			<th width="10%" align="center"><p class="h" align="center">${data.heads.taxCode?html}</p></th>
			<th width="11%" align="center"><p class="h" align="center">${data.heads.personalId?html}</p></th>
			<th width="7%" align="center"><p class="h" align="center">${data.heads.hours?html}</p></th>
			<th width="9%" align="center"><p class="h" align="center">${data.heads.rate?html}</p></th>
			<th width="11%" align="center"><p class="h" align="center">${data.heads.gross?html}</p></th>
			<th width="10%" align="center"><p class="h" align="center">${data.heads.pit?html}</p></th>
			<th width="11%" align="center"><p class="h" align="center">${data.heads.net?html}</p></th>
			<th width="9%" align="center"><p class="h" align="center">${data.heads.sign?html}</p></th>
		</tr></thead>
		<#list data.rows as r>
		<tr>
			<td align="center">${r.stt}</td><td>${r.name?html}</td><td>${r.taxCode?html}</td><td>${r.personalId?html}</td>
			<td align="right">${r.hours}</td><td align="right">${r.rate}</td><td align="right">${r.gross}</td><td align="right">${r.pit}</td>
			<td align="right" class="b">${r.net}</td><td></td>
		</tr>
		</#list>
		<tr>
			<td></td><td colspan="3" class="b">${data.heads.total?html}</td>
			<td align="right" class="b">${data.total.hours}</td><td></td><td align="right" class="b">${data.total.gross}</td><td align="right" class="b">${data.total.pit}</td>
			<td align="right" class="b">${data.total.net}</td><td></td>
		</tr>
	</table>
	<p class="i" style="margin-top: 4px;">${data.netWords?html}</p>
	<table width="100%" table-layout="fixed" style="margin-top: 8px; page-break-inside: avoid;">
		<tr><#list data.signers as s><td width="33%" align="center"><span class="b">${s.title?html}</span><br/><span class="small i">${data.signNote?html}</span><br/><br/><br/><br/>${s.name?html}</td></#list></tr>
	</table>
</body>
</pdf>
